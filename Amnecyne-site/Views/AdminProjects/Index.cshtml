@model List<Amnecyne.DataModels.Project>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">Projects</h1>
        <a href="/admin/projects/create" class="btn btn-primary">New project</a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table project-accent-table table-hover align-middle border-top">
                <thead class="table-light">
                <tr>
                    <th></th>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr style="--project-color: @p.PrimaryColor;">
                        <td>
                            @if (p.IconPath is not null)
                            {
                                <img src="/uploads/@p.IconPath" width="28" height="28" class="rounded" alt="" />
                            }
                            else
                            {
                                <span class="project-accent-dot"></span>
                            }
                        </td>
                        <td class="fw-bold">@p.Name</td>
                        <td><span class="badge bg-secondary">@p.State</span></td>
                        <td>@(p.IsFeatured ? "★" : "")</td>
                        <td class="text-end">
                            <a href="/admin/projects/@p.Id/edit" class="btn btn-sm btn-outline-dark">Edit</a>
                            <form method="post" action="/admin/projects/@p.Id/delete" class="d-inline" onsubmit="return confirm(@System.Text.Json.JsonSerializer.Serialize("Delete " + p.Name + "?"))">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No projects yet. Create one to get started.</div>
    }
</div>