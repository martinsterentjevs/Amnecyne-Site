@model List<Amnecyne.DataModels.Tag>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">Tags</h1>
        <a href="/admin/tags/create" class="btn btn-primary">New tag</a>
    </div>

    @if (Model.Any())
    {
        <table class="table table-hover align-middle border-top">
            <thead class="table-light"><tr><th>Name</th><th>Slug</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Name</td>
                    <td><code>@t.Slug</code></td>
                    <td class="text-end">
                        <a href="/admin/tags/@t.Id/edit" class="btn btn-sm btn-outline-dark">Edit</a>
                        <form method="post" action="/admin/tags/@t.Id/delete" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No tags yet.</div>
    }
</div>
