@model Amnecyne.Models.ReleaseFormViewModel

<form method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        @Html.EditorFor(m => m.ProjectId)
    </div>

    <div class="mb-3">
        <label asp-for="Version" class="form-label"></label>
        <input asp-for="Version" class="form-control" />
        <span asp-validation-for="Version" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReleaseDate" class="form-label"></label>
        <input asp-for="ReleaseDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="DownloadUrl" class="form-label"></label>
        <input asp-for="DownloadUrl" class="form-control" />
        <span asp-validation-for="DownloadUrl" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
