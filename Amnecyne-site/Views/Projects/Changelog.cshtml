@model (Amnecyne.DataModels.Project Project, System.Collections.Generic.List<Amnecyne.DataModels.ChangelogEntry> Entries)

@{
    ViewData["Title"] = $"{Model.Project.Name} — Changelog";
}

<h1>@Model.Project.Name — Changelog</h1>

@if (Model.Entries.Count == 0)
{
    <p class="body-text">No changelog entries yet.</p>
}
else
{
    <ul>
        @foreach (var entry in Model.Entries)
        {
            <li><strong>@entry.Date.ToString("yyyy-MM-dd")</strong> — @entry.Description</li>
        }
    </ul>
}