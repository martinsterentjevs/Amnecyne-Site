@model IEnumerable<Amnecyne.DataModels.Project>

<div class="container mt-5">
    <h1 class="mb-4">My Projects</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border-top">
                <thead class="table-light">
                    <tr>
                        <th>Project</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model)
                    {
                        @* Inject the project's hex color as a CSS variable *@
                        <tr style="--project-color: @project.PrimaryColor;">
                            <td class="fw-bold">
                                <span class="project-accent-dot"></span>
                                @project.Name
                            </td>
                            <td>@project.Description</td>
                            <td><span class="badge bg-secondary">Active</span></td>
                            <td class="text-end">
                                <a href="/projects/@project.Slug" class="btn btn-sm btn-outline-dark">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No projects found. Add one in the admin panel!</div>
    }
</div>

<style>
    /* The "Gap-Divider" Trick */
    .table tbody tr {
        transition: all 0.2s ease-in-out;
        border-bottom: 2px solid transparent; /* Reserve space for the divider */
    }

    /* Use the dynamic variable to color the divider and hover effect */
    .table tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.02);
        border-bottom-color: var(--project-color);
        transform: translateX(4px);
    }

    /* Project-specific accent dot */
    .project-accent-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--project-color);
        margin-right: 10px;
    }

    /* Custom divider style */
    .table-hover tbody tr:last-child {
        border-bottom: none;
    }
</style>