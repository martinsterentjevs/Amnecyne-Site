@model IEnumerable<Amnecyne.DataModels.Project>

<div class="container mt-5">
    <h1 class="mb-4">My Projects</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table project-accent-table table-hover align-middle border-top">
                <thead class="table-light">
                <tr>
                    <th>Project</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var project in Model)
                {
                    <tr style="--project-color: @project.PrimaryColor;">
                        <td class="fw-bold">
                            <span class="project-accent-dot"></span>
                            @project.Name
                        </td>
                        <td>@project.Description</td>
                        <td><span class="badge bg-secondary">@project.State</span></td>
                        <td class="text-end">
                            <a href="/projects/@project.Slug" class="btn btn-sm btn-outline-dark">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No projects found. Add one in the admin panel!</div>
    }
</div>